backup (){
    #check if $1 is a direcroty or file
    if [[ -d $1 ]]; then
        dir=${1%/} # this will strip the trailing slash
        newname="$dir.$(date +%Y-%m-%d.%H%M%S.bak)"
        if tar -zcvf $newname.tar $dir; then
          log_success "Created backup of $1, have a nice day"
        else
            log_error "Could not create backup of $1"
        fi
    else
        # if it's a file
        newname=$1.$(date +%Y-%m-%d.%H%M%S.bak);
        if cp -pr "$1" "$newname"; then
            log_success "Created backup of $1, have a nice day"
        else
            log_error "Could not create backup of $1"
        fi
    fi


}

