alias status='systemctl status'

alias size='du -hs'
alias rm='rm -i'
alias less='less -R'

alias catjson='python3 -m json.tool'

alias sourcebash='source $HOME/.bashrc'

#Networking
alias ips='ip -br -c a'
alias macs='ip -br -c l'
alias routes='ip -br -c r'

#Vim
alias vim='vim -u $HOME/imports/.vimrc'

#Tmux
TERM=xterm-256color
if [ -f /usr/bin/tmux ]; then
	tmux source-file $HOME/imports/.tmux.conf
fi

#Functions
cd() { builtin cd "$@" && ls; }

restart() { if sudo systemctl restart "$1"; then
                log_success "Process $1 restarted successfully"
            else
                log_error "Something went wrong restarting process $1"
            fi
             systemctl status "$1";
           }

backup (){
    newname=$1.`date +%Y-%m-%d.%H%M%S.bak`;
    if cp -p $1 $newname; then
        log_success "Created backup of $1, have a nice day"
    else
        log_error "Could not create backup of $1"
    fi
}

