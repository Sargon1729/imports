    fi
}

docker-prune () {
	read -r -p "Remove all stopped containers? (y/n): " prompt
        if [[ $prompt = "y" ]]; then
        #Check if output is zero length
            if [[ -z $(docker ps -a --filter "status=exited" -q)  ]]; then
                 log_info "No containers to prune"
                return
            else
                for i in $(docker ps -a --filter "status=exited" -q); do
                    docker rm "$i"
                    done
                rc=$?
